# Canonical site URL. Used for metadata, the sitemap and robots.txt.
# In production set this to your real domain, e.g. https://alexrivera.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form (optional) ---
# Without these the form still renders and validates, but reports that it is
# not configured yet. Create an API key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
