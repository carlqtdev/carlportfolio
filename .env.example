# Canonical site URL, used for canonical tags, the sitemap and robots.txt.
#
# Optional on Vercel: the build falls back to VERCEL_PROJECT_PRODUCTION_URL, so
# a *.vercel.app deployment is correct with no configuration. Set this only once
# you attach a custom domain, and note it is inlined at build time, so changing
# it requires a redeploy.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Contact form (optional) ---
# Without these the form still renders and validates, but reports that it is
# not configured yet. Create an API key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
